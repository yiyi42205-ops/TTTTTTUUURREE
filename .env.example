GEMINI_API_KEY=your_key_here
APIFY_TOKEN=your_apify_token_here

# Playwright fallback is disabled by default. Set to "true" to let /api/scrape
# fall back to the local Playwright scraper when Apify fails.
ENABLE_PLAYWRIGHT_FALLBACK=false

# Audit mode: "production" (default) caps Stage 2 Gemini audit at 15 reviews
# with stratified sampling to control API cost. Set to "evaluate" to send all
# ambiguous reviews for full-coverage offline evaluation.
VITE_AUDIT_MODE=production

# Allowed hosts for development / tunnels (comma-separated list)
VITE_ALLOWED_HOSTS=

# CORS allowed origins (comma-separated). Leave empty to allow all (dev only).
# Example: CORS_ORIGINS=https://truerating.fly.dev,https://yourdomain.com
CORS_ORIGINS=

